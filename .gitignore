# Publish source/documentation by allowlist. Final ZIP has a separate exact manifest.
*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE.md
!/CONTRIBUTING.md
!/config.example.json
!/usaga.py
!/usaga_tools/
!/usaga_tools/**/
!/usaga_tools/**/*.py
!/docs/
!/docs/*.md
!/docs/*PROVENANCE.json
!/tests/
!/tests/*.py
!/research/
!/research/README.md
!/.github/
!/.github/workflows/
!/.github/workflows/tests.yml
**/__pycache__/
**/*.pyc
**/*.iso
**/*.bin
**/*.elf
**/*.tm2
**/*.png
**/*.jpg
**/*.csv
**/*.ttf
**/*.otf
**/*.ps2
**/*.p2s
**/*.zip
**/*.dll
**/*.pyd
**/*.exe
**/*.log
**/config.json
**/.env
**/.env.*
**/vendor/
**/_temp/
**/_cache/
**/_logs/
